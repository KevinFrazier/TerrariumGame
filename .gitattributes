* text=auto eol=lf

# Godot text resources should be LF
*.gd       text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.godot    text eol=lf
*.cfg      text eol=lf
*.import   text eol=lf

# Treat common asset formats as binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.ogg      binary
*.wav      binary
*.mp3      binary
*.ttf      binary
*.otf      binary
